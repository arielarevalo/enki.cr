{
  "name": "enki-api",
  "type": "module",
  "scripts": {
    "dev:setup": "bash scripts/dev-setup.sh",
    "dev": "npm run dev:setup && wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "type-check": "npm run types && tsc",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "bash tests/e2e/run-e2e.sh",
    "test:e2e:local": "bash tests/e2e/run-e2e.sh local",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply enki-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply enki-db --remote"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.0",
    "@hono/zod-openapi": "^1.2.2",
    "drizzle-orm": "^0.39",
    "hono": "^4.12.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30",
    "typescript": "^5.8",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
