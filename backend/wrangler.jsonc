{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enki-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enki-db",
      "database_id": "69d7ed7d-0f96-4abc-bb3a-b7adeb49ad3c",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "AGENTS_BASE_URL": "https://agents.enki.cr"
  }
}
