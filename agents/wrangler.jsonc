{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enki-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "OUTLINE_DEEP_AGENT", "class_name": "OutlineDeepAgent" },
      { "name": "OUTLINE_REACT_AGENT", "class_name": "OutlineReactAgent" },
      { "name": "OUTLINE_WORKFLOW_AGENT", "class_name": "OutlineWorkflowAgent" }
    ]
  },
  // OPENROUTER_API_KEY is set via secrets; declared here so wrangler types includes it
  "vars": {
    "OPENROUTER_API_KEY": ""
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OutlineDeepAgent",
        "OutlineReactAgent",
        "OutlineWorkflowAgent"
      ]
    }
  ]
}
